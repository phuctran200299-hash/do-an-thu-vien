    AUTHORS ||--o{ BOOK_AUTHORS : "viet"
    CATEGORIES ||--o{ BOOKS : "phan_loai"
    BOOKS ||--o{ BORROW_RECORDS : "duoc_muon"
    BOOKS ||--o{ FAVORITES : "duoc_thich"
    BOOKS ||--o{ REVIEWS : "duoc_danh_gia"
    BOOKS ||--o{ RESERVATIONS : "duoc_dat_truoc"
    BOOKS ||--o{ AI_RECOMMENDATION_LOGS : "de_xuat"
